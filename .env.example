# Copy this file to ".env" and adjust values. ".env" is git-ignored; this file is not.
# Docker Compose reads ".env" automatically.

# --- Host ports (change one if it clashes with something already running locally) ---
MONGO_PORT=27017
REDIS_PORT=6379
POSTGRES_PORT=5432
SQLSERVER_PORT=1433
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672

# --- PostgreSQL (Payments) ---
POSTGRES_USER=smartstore
POSTGRES_PASSWORD=smartstore
POSTGRES_DB=paymentsdb

# --- SQL Server (Notifications) - min 8 chars, upper + lower + digit + symbol ---
SQLSERVER_SA_PASSWORD=SmartStore@12345

# --- RabbitMQ ---
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# --- AI assistant (Catalog API, used from step 6) ---
# Any OpenAI-compatible endpoint: OpenAI (https://api.openai.com/v1)
# or local Ollama (http://host.docker.internal:11434/v1, API key can be anything).
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini
